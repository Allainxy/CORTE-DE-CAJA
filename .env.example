# Renombra este archivo a .env y rellena los valores
# (NO subas .env a GitHub)

# Cadena larga aleatoria para firmar JWTs (mínimo 32 chars)
# Genérala con:  openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-string-largo-y-aleatorio-min-32-chars-aqui

# Email para Let's Encrypt (avisos de caducidad del certificado)
EMAIL=admin@kbomx.com
